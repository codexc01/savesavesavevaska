# ============================================================
# SaveMOD Bot — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# Telegram
# -----------------------------------------------------------
# Your bot token from @BotFather
BOT_TOKEN=your_bot_token_here

# Telegram User ID of the admin (get it from @userinfobot)
ADMIN_ID=123456789

# Webhook URL (only needed in production webhook mode)
# Example: https://yourdomain.com/webhook
WEBHOOK_URL=

# Webhook secret token for request validation (generate a random string)
WEBHOOK_SECRET=

# -----------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=savemod
POSTGRES_USER=savemod
POSTGRES_PASSWORD=change_me_strong_password

# Full DSN is auto-constructed from the above, but you can override:
# DATABASE_URL=postgresql+asyncpg://savemod:password@postgres:5432/savemod

# -----------------------------------------------------------
# Redis
# -----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DB=0

# -----------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------
# "webhook" or "polling" (polling is convenient for local dev)
BOT_MODE=polling

# Days to keep cached (not-yet-deleted) messages
MESSAGE_CACHE_TTL_DAYS=7

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Render structured logs as JSON (true in production, false for dev)
LOG_JSON=false

# -----------------------------------------------------------
# Media / Storage
# -----------------------------------------------------------
# Local temp dir for any media that must be downloaded temporarily
TEMP_MEDIA_DIR=/tmp/savemod_media

# (Future) S3-compatible object storage
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
